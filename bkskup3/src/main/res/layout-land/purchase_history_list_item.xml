<?xml version="1.0" encoding="utf-8"?>

<com.bk.layout.CheckableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/openPurchasesListItem"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/checkable_background_red"
    android:gravity="center_vertical"
    android:minHeight="40sp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/purchaseHerdCell"
        style="@style/list_cell"
        android:layout_width="0dp"
        android:layout_height="fill_parent"
        android:layout_weight="0.1" />

    <View
        android:id="@+id/divider1"
        android:layout_width="1dp"
        android:layout_height="fill_parent"
        android:background="@drawable/white_divider" />

    <TextView
        android:id="@+id/purchaseStartEndDtCell"
        style="@style/list_cell"
        android:layout_width="0dp"
        android:layout_height="fill_parent"
        android:layout_weight="0.7" />

    <View
        android:id="@+id/divider2"
        android:layout_width="1dp"
        android:layout_height="fill_parent"
        android:background="@drawable/white_divider" />


    <TextView
        android:id="@+id/purchaseCowAmountCell"
        style="@style/list_cell"
        android:layout_width="0dp"
        android:layout_height="fill_parent"
        android:layout_weight="0.1" />

    <View
        android:id="@+id/divider3"
        android:layout_width="1dp"
        android:layout_height="fill_parent"
        android:background="@drawable/white_divider" />


    <ImageView
        android:id="@+id/purchaseStateCell"
        android:layout_width="0dp"
        android:layout_height="fill_parent"
        android:layout_weight="0.1"
        android:gravity="center_vertical|center_horizontal"
        
        />

</com.bk.layout.CheckableLinearLayout>


